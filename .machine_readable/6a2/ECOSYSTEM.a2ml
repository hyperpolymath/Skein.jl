# SPDX-License-Identifier: MPL-2.0
# ECOSYSTEM.a2ml — Ecosystem position
# Refreshed 2026-06-05 (corrected: KRL is a resolution language, NOT a query language)
# Refreshed 2026-06-18 (reconcile: the four KRL ops are operations, not component labels)
# Re-grounded 2026-09-26 (ADR-0001: Skein = standalone knot-database library; QuandleDB/KRL/Tangle = consumers; the former 'compute/backend engine of the KRL stack' role is withdrawn)

[metadata]
project = "Skein.jl"
ecosystem = "hyperpolymath"

[position]
type = "library"
role = "Standalone knot-database library for Julia (ADR-0001): stores Gauss codes / canonical planar diagrams, computes and indexes invariants on insert, answers invariant and equivalence queries over an embedded SQLite store. QuandleDB — which hosts the KRL implementation — is the flagship in-estate CONSUMER; consumption defines neither Skein's purpose nor its architecture (INTEGRATION.adoc)."

# KRL = Knot Resolution Language: a COMPOSITIONAL language for Construct,
# Transform, Resolve, Retrieve over tangles/knots/links. It is NOT a query
# language — "resolution" (as in the skein relation) is the central act;
# Retrieve/"query" is only one of the four operations.
# Historical context, recorded so the correction is traceable: the 2026-06
# '4-layer KRL stack' table (surface → TangleIR → core → substrate) described a
# consumer-side architecture and is retained in krl/quandledb docs, not here.
# Skein carries no KRL-specific types, schema or vocabulary.
[krl-stack]
consumer-note = "KRL surface + grammar live in krl/quandledb (server-side parser quandledb/server/krl/); TangleIR interchange is defined consumer-side and consumed by hyperpolymath/tangle. Skein.jl is the persistence/invariant store those tools consume as a plain Julia library."

[skein-role]
library = "computes and caches knot invariants (Jones, genus, Seifert circles) and equivalence checks, over an embedded SQLite store. Generic query access (find where jones = p, where crossing < 8) is a plain database affordance — not a KRL operation and not 'the Retrieve leg' of anything."
retrieve-clause = "KRL's Retrieve recovers resolution-relevant artefacts (presentations, invariants, witnesses, equivalence classes, prior resolutions, explanations, provenance) — NOT arbitrary database querying. See krl docs/decisions/0002-query-language-deferred.adoc."
knottheory = "weakdep — invariant engine; loaded via ext/KnotTheoryExt.jl. (KRL's README calls the invariant engine JuliaKnot.jl — naming to reconcile.)"
quandledb = "the database application that wraps Skein — the canonical persistence + invariant/equivalence face (where presentations, invariants, fingerprints, equivalence classes, witnesses, results live), plus the equivalence/Resolve surface (equivalent?, classify, near). NOT 'an app that queries Skein'."

# These three sibling database languages are each a DISTINCT paradigm.
# Do NOT flatten any of them to SQL / 'query'.
[distinct-from]
gnpl = "Glyph Narration & Projection Language (Lithoglyph / Glyphbase) — synchronic + diachronic data: what it is, whence, whither; reading/writing those stories + counterfactuals"
vcl = "VeriSim Consonance Language (VeriSimDB) — identity / consonance: propose / inspect / verify identity-states, not retrieval of octad components"
