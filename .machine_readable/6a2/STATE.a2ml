# STATE.a2ml — Project state checkpoint
# Refreshed 2026-09-26; one-master re-grounding per ADR-0001 (docs/decisions/)

[metadata]
project = "Skein.jl"
version = "0.4.0"
last-updated = "2026-09-26"
status = "active"

[project-context]
name = "Skein.jl"
completion-percentage = 75
phase = "Beta — standalone knot-database library for Julia (storage + invariants + queries); QuandleDB/KRL are consumers, not its purpose (ADR-0001)"

[capabilities]
storage = "SQLite backend, schema v4 (WAL mode), invariants auto-computed on insert; PD-native fields (diagram_format, canonical_diagram, pd_code)"
invariants-standalone = "crossing_number, writhe, gauss_hash, Jones (<=15 crossings), genus, Seifert circles, canonical diagram"
invariants-with-knottheory = "Alexander, determinant, signature via ext/KnotTheoryExt.jl"
retrieve = "keyword (exact/range/set/meta) + composable & / | predicates; equivalence (find_equivalents, find_isotopic), duplicates, statistics, pagination. (Engine-layer query access over the embedded store; KRL's Retrieve operation recovers resolution-relevant artefacts and runs against the QuandleDB+Skein substrate — Skein is not 'the Retrieve leg'.)"
data = "KnotInfo/Rolfsen import through 8 crossings; prime-knot table through 7 (knot_table.jl); CSV/JSON; DT-to-Gauss"
tests = "1089 tests, all passing (test/runtests.jl + e2e / property / canonical / knot-theory-ext; verified green 2026-06-14)"

[current-focus]
direction = "Knot database as the maths analogue of a graph database (owner framing). Skein serves ONE master — general Julia users who want knot storage/indexing/querying; QuandleDB/KRL/Tangle consume it from their own repos. The 2026-06 'engine of the KRL stack' self-description is superseded by ADR-0001 (docs/decisions/ADR-0001-skein-serves-one-master.adoc)."

[withdrawn]
# (1) An earlier draft of this checkpoint proposed a Skein 'typed
# knot-relationship edge layer + traversal (connected-sum DAG, skein triples)'.
# That was authored on a MISTAKEN 'KRL = query language' model and is WITHDRAWN.
# No committed next schema version until specified against Skein's own storage
# requirements.
#
# (2) WITHDRAWN 2026-09-26 (ADR-0001): the 'computational/backend engine of the
# KRL stack' role, the AcceleratorGate.jl hard dependency + twelve accelerator
# package extensions, and the Idris2/Zig ABI/FFI seam (src/abi/, ffi/zig/,
# generated/abi/) — AI cross-contamination from the RSR template and the
# Axiom/AcceleratorGate estate. Nothing in src/, test/, benchmark/ or any
# downstream consumer ever called them; nine of twelve extensions were not
# even declared in Project.toml [extensions] and could never load. The estate's
# Template-Applicability-Policy (standards 0-canon) classifies all of it as
# VESTIGIAL. Re-adding any of it requires declaring the capability in
# .machine_readable/rsr-profile.a2ml with justification and CI that exercises it.

[open]
test-baseline = "CI Julia 1.10 + 1.11 matrix green on main (2026-09-25 run 36199547359). Since 0.4.0 the package installs standalone: KnotTheory.jl is weakdep-only again and the only environment prep is dev-ing that one unregistered weakdep for the test target. Manifest.toml is no longer committed (it pinned 1.12 stdlibs unsatisfiable on the 1.10/1.11 matrix)."
alexander-standalone = "Alexander polynomial not computed standalone (needs PD/chirality; pd_code field enables a route)"
julia-1_9 = "test (1.9) fails at Pkg.instantiate (dependency requires >= 1.10)"

[notes]
ecosystem = "Skein.jl = standalone knot-database library (this repo). QuandleDB = the in-estate application that wraps Skein for persistence + invariant/equivalence queries and hosts the KRL resolution-language implementation. KnotTheory.jl = the computation toolkit behind the optional extension. Tangle = a separate knot-mathematics language; no compilation pipeline connects it to Skein. Consumption does not transfer purpose, schema or proof guarantees (INTEGRATION.adoc, ADR-0001)."
