# SPDX-License-Identifier: MPL-2.0
# Mustfile — Physical state contract for Skein.jl
# Author: Jonathan D.A. Jewell <j.d.a.jewell@open.ac.uk>
#
# What MUST be true about this repository. Hard requirements.
# Run with: must check
# Fix with: must fix (where a deterministic fix exists)

@abstract:
Physical-state invariants for Skein.jl: a standalone Julia knot-database
library. These are hard requirements — CI and pre-commit hooks fail if any
check fails.
@end

@requires:
- section: Core-Files
- section: Package-Integrity
- section: Directory-Structure
- section: Git-State
@end

## Core-Files

### license-present
- description: LICENSE file must exist
- run: test -f LICENSE
- severity: critical

### readme-present
- description: README.adoc must exist
- run: test -f README.adoc
- severity: critical

### security-policy
- description: SECURITY.adoc must exist (this repo's .adoc-canonical security policy)
- run: test -f SECURITY.adoc
- severity: critical

### ai-manifest
- description: 0-AI-MANIFEST.a2ml must exist
- run: test -f 0-AI-MANIFEST.a2ml
- severity: critical

### governance-docs
- description: GOVERNANCE.adoc, MAINTAINERS.adoc, CODEOWNERS must exist
- run: test -f GOVERNANCE.adoc && test -f MAINTAINERS.adoc && test -f .github/CODEOWNERS
- severity: critical

### machine-readable-dir
- description: .machine_readable/ directory must exist
- run: test -d .machine_readable
- severity: critical

## Package-Integrity

### julia-project
- description: Project.toml must exist and name the Skein package
- run: grep -q '^name = "Skein"' Project.toml
- severity: critical

### knottheory-weakdep-only
- description: KnotTheory.jl must never be a hard dependency (adr-weakdep; 0-AI-MANIFEST agent-may-not)
- run: test -z "$(python3 -c "import tomllib;d=tomllib.load(open('Project.toml','rb'));print([k for k in d.get('deps',{}) if k=='KnotTheory'])")"
- severity: critical

### no-accelerator-dependency
- description: AcceleratorGate.jl (or any coprocessor backend package) must not be a dependency (ADR-0001)
- run: test -z "$(grep -i 'acceleratorgate' Project.toml)"
- severity: critical

### no-manifest-committed
- description: Manifest.toml must not be committed (packages pin [compat], not resolved graphs)
- run: test -z "$(git ls-files Manifest.toml)"
- severity: critical

### extension-registry-consistency
- description: every ext/*.jl extension module is declared in Project.toml [extensions]
- run: bash -c 'for f in ext/*.jl; do grep -q "$(basename "$f" .jl)" Project.toml || exit 1; done'
- severity: critical

## Directory-Structure

### contractiles-complete
- description: All required contractile directories exist
- run: test -d .machine_readable/contractiles && test -d .machine_readable/contractiles/bust && test -d .machine_readable/contractiles/dust
- severity: critical

### contractiles-files-present
- description: All four primary contractile files exist
- run: test -f .machine_readable/contractiles/Intentfile.a2ml && test -f .machine_readable/contractiles/Mustfile.a2ml && test -f .machine_readable/contractiles/Trustfile.a2ml && test -f .machine_readable/contractiles/Adjustfile.a2ml
- severity: critical

### bust-dust-files-present
- description: Bustfile and Dustfile exist in their directories
- run: test -f .machine_readable/contractiles/bust/Bustfile.a2ml && test -f .machine_readable/contractiles/dust/Dustfile.a2ml
- severity: critical

### six-directory-present
- description: 6a2 checkpoint directory exists with required files
- run: test -d .machine_readable/6a2 && test -f .machine_readable/6a2/META.a2ml && test -f .machine_readable/6a2/ECOSYSTEM.a2ml && test -f .machine_readable/6a2/STATE.a2ml && test -f .machine_readable/6a2/PLAYBOOK.a2ml && test -f .machine_readable/6a2/AGENTIC.a2ml && test -f .machine_readable/6a2/NEUROSYM.a2ml
- severity: critical

### anchor-directory
- description: 6a2 anchor entry point exists
- run: test -f .machine_readable/6a2/anchor/ANCHOR.a2ml
- severity: warning

### rsr-profile-present
- description: capability profile exists (TEMPLATE-APPLICABILITY-POLICY)
- run: test -f .machine_readable/rsr-profile.a2ml
- severity: critical

## Git State

### no-untracked-contractiles
- description: All contractile files are tracked in git
- run: test -z "$(git ls-files -o --exclude-standard .machine_readable/contractiles/ 2>/dev/null)"
- severity: critical
