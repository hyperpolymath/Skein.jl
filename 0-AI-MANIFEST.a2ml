; SPDX-License-Identifier: MPL-2.0
; 0-AI-MANIFEST.a2ml — Skein.jl

[ai-contract]
purpose = "A standalone knot-theoretic database library for Julia: store knots as Gauss codes (or canonical planar diagrams via the optional KnotTheory.jl extension), compute and index invariants on insert, query, compare and import/export them. Serves general Julia users first; QuandleDB/KRL and Tangle are separate projects that consume this library (see INTEGRATION.adoc) — consumption defines neither purpose nor architecture."
agent-may = "edit src/, ext/, test/, benchmark/, examples/, docs/, CHANGELOG.adoc, ROADMAP.adoc, .machine_readable/6a2/"
agent-may-not = "edit LICENSE / SECURITY.adoc without explicit user confirmation; add KnotTheory.jl or any estate package (AcceleratorGate, Axiom, ...) as a hard dependency — KnotTheory is weakdep-only by adr-weakdep; reintroduce an ABI/FFI seam (Idris2/Zig/generated headers) or coprocessor/accelerator extensions — both are VESTIGIAL here per .machine_readable/rsr-profile.a2ml and ADR-0001 (docs/decisions/), and re-adding them requires declaring the capability with justification plus CI that exercises it; resurrect the withdrawn 'knot graph database / typed knot-relation edge layer / schema v5' framing (see 6a2/STATE.a2ml) without re-grounding against this repo's own storage requirements"
agent-must-after = "code-edit -> real Pkg.test() run (tests must pass before commit); Manifest.toml stays uncommitted"

[escalation]
breaking-changes = "open ADR; respect 6a2/META.a2ml decisions"
schema-change = "re-ground against Skein's own storage requirements first; do not resurrect the withdrawn edge-layer v5"
schema-drift-in-6a2 = "Open issue against hyperpolymath/standards; do not silently reshape this repo's 6a2 files"
